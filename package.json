{
  "name": "agentic-term",
  "description": "AI-powered terminal emulator with local RAG and workflow automation",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "author": "runzel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/runzel/Agentic-Term"
  },
  "bugs": {
    "url": "https://github.com/runzel/Agentic-Term/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pre-commit": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0",
    "@tauri-apps/plugin-opener": "^2.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.34.0",
    "postcss": "^8.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^1.0.0"
  }
}
